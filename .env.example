# Copy this file to .env and adjust if the backend runs elsewhere.
VITE_API_URL=http://localhost:5000

# On Vercel specifically: leave VITE_API_URL EMPTY in the project's env
# vars (not the Render backend URL) — vercel.json rewrites /api/* and
# /uploads/* to the backend, so requests should stay relative/same-origin.
# This is what keeps the SameSite=Lax auth cookies working cross-host; see
# src/lib/api.js's BASE_URL comment.

# Sentry error monitoring — optional. If unset, the app runs exactly as it
# does today; errors just aren't additionally reported anywhere. Get a DSN
# from https://sentry.io (free tier) once you want this active.
VITE_SENTRY_DSN=
