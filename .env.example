# Copy this file to .env and adjust if the backend runs elsewhere.
VITE_API_URL=http://localhost:5000

# On Vercel specifically: do NOT set VITE_API_URL at all (Vercel's env var
# UI requires a non-empty value, so there's no way to "set it empty" there).
# Leaving it unset makes src/lib/api.js default to relative URLs in any
# production build, and vercel.json rewrites /api/* and /uploads/* to the
# backend — that's what keeps the SameSite=Lax auth cookies working across
# Vercel/Render being different hosts. See src/lib/api.js's BASE_URL comment.

# Sentry error monitoring — optional. If unset, the app runs exactly as it
# does today; errors just aren't additionally reported anywhere. Get a DSN
# from https://sentry.io (free tier) once you want this active.
VITE_SENTRY_DSN=
