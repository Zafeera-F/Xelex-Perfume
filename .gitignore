# Dependencies
node_modules/

# Environment files — never commit real secrets/credentials.
# .env.example files ARE tracked (they're just templates).
.env
.env.*
!.env.example

# Build output
dist/
dist-ssr/
build/

# Admin-uploaded product images — runtime data, not source.
# The upload middleware recreates this directory automatically.
backend/uploads/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vite
*.local
