{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://xelex-backend.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://xelex-backend.onrender.com/uploads/:path*" },
    { "source": "/((?!api/|uploads/).*)", "destination": "/index.html" }
  ]
}
