# Copy this file to .env and fill in your real values. Never commit .env itself.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/xelex_perfumes?schema=public"

# Express server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# JWT auth
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Admin JWT auth — must be a DIFFERENT random string from JWT_SECRET above,
# so customer and admin sessions are cryptographically isolated from each
# other. Generate the same way as JWT_SECRET.
ADMIN_JWT_SECRET=replace_this_with_a_different_long_random_string

# Bootstrap admin — consumed only by `npm run prisma:seed` to create/refresh
# the single SUPER_ADMIN row. Password must be 8+ chars with at least one
# uppercase letter and one number. Change it after first login.
ADMIN_EMAIL=admin@xelexperfumes.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_FULL_NAME=XeleX Super Admin

# Razorpay (UPI payments) — get these from https://dashboard.razorpay.com/
# under Settings > API Keys (test-mode keys are free and instant, no
# business verification needed to start building/testing against them).
# Optional: if unset, the app still runs fine — COD checkout, auth,
# browsing, everything else works normally. Only the UPI payment routes
# report "not configured" (503) until these are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the webhook you configure in the Razorpay dashboard (Settings >
# Webhooks), pointed at POST /api/payments/razorpay/webhook. Used to verify
# that a webhook call genuinely came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=
