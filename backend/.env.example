# Copy this file to .env and fill in your real values. Never commit .env itself.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/xelex_perfumes?schema=public"

# Express server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# JWT auth — JWT_EXPIRES_IN is the ACCESS token's lifetime specifically
# (kept short on purpose). The long-lived refresh token that issues new
# access tokens isn't a JWT at all (see backend/src/utils/refreshToken.js)
# and isn't configured here — its lifetime is REFRESH_TOKEN_EXPIRES_IN_MS
# in that file.
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# Admin JWT auth — must be a DIFFERENT random string from JWT_SECRET above,
# so customer and admin sessions are cryptographically isolated from each
# other. Generate the same way as JWT_SECRET.
ADMIN_JWT_SECRET=replace_this_with_a_different_long_random_string

# Bootstrap admin — consumed only by `npm run prisma:seed` to create/refresh
# the single SUPER_ADMIN row. Password must be 8+ chars with at least one
# uppercase letter and one number. Change it after first login.
ADMIN_EMAIL=admin@xelexperfumes.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_FULL_NAME=XeleX Super Admin

# Razorpay (UPI payments) — get these from https://dashboard.razorpay.com/
# under Settings > API Keys (test-mode keys are free and instant, no
# business verification needed to start building/testing against them).
# Optional: if unset, the app still runs fine — COD checkout, auth,
# browsing, everything else works normally. Only the UPI payment routes
# report "not configured" (503) until these are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the webhook you configure in the Razorpay dashboard (Settings >
# Webhooks), pointed at POST /api/payments/razorpay/webhook. Used to verify
# that a webhook call genuinely came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=

# SMTP (transactional emails — order confirmation, payment success,
# shipped/delivered/cancelled). Optional: if unset, the app still runs
# fine — order placement, payments, everything else works normally, the
# emails just silently don't send (retried a few times, then logged, never
# thrown back into the request that triggered them).
# For local testing, a free sandbox inbox works well and needs no real
# mailbox: https://mailtrap.io (or nodemailer's own https://ethereal.email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="XeleX Perfume <no-reply@xelexperfumes.com>"

# SMS (order placed/shipped/out for delivery/delivered) via MSG91
# (https://msg91.com). Optional: if unset, the app still runs fine — same
# graceful-degradation posture as SMTP above, sends just silently don't go
# out (retried a few times, then logged, never thrown back into the order/
# status-update flow that triggered them).
# MSG91's compliant delivery routes require a pre-registered, DLT-approved
# template per message (a TRAI requirement for transactional SMS to Indian
# numbers) — register these in the MSG91 dashboard and paste the resulting
# template IDs below. Each template's placeholder variable names must match
# what sms.service.js sends (currently var1 = order number).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ORDER_PLACED=
MSG91_TEMPLATE_ORDER_SHIPPED=
MSG91_TEMPLATE_OUT_FOR_DELIVERY=
MSG91_TEMPLATE_DELIVERED=

# Sentry error monitoring — optional. If unset, the app runs exactly as it
# does today; unexpected errors are still console.error'd server-side (see
# middlewares/errorHandler.js), just not additionally reported anywhere.
# Get a DSN from https://sentry.io (free tier) once you want this active.
SENTRY_DSN=
