// XeleX Venture — Prisma Schema
// -----------------------------------------------------------------------------
// Database: PostgreSQL
// All primary keys are UUIDs. All models carry createdAt/updatedAt.
// Soft delete (deletedAt) is used where a row needs to disappear from active
// use while still being safely referenced by historical records (orders,
// reviews, etc.) — see the per-model notes below for what does NOT soft-delete
// and why.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  UPI
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  STAFF
}

enum PaymentIntentStatus {
  CREATED
  PAID
  FAILED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

// -----------------------------------------------------------------------------
// USERS
// -----------------------------------------------------------------------------

// Soft-deletes: a user closing their account shouldn't break the history of
// orders/reviews they left behind — those rows keep a valid FK either way.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  fullName      String
  // Nullable — a phone-first account (created by verifying an OTP for an
  // unregistered number, see auth.service.js's verifyPhoneOtp) has neither
  // until it optionally adds them later via setInitialCredentials. Same
  // "Postgres treats each NULL as distinct" reasoning already used for
  // phone below, so multiple email-less accounts never collide on the
  // unique constraint.
  email         String?   @unique
  passwordHash  String?
  // Unique so a phone number can double as a login identifier alongside
  // email (see auth.service.js's login) — Postgres allows multiple NULLs
  // under a unique constraint, so accounts that never set a phone are
  // unaffected. Pre-flight duplicate check run against production data
  // before this migration; any collisions found were resolved by keeping
  // each duplicate group's oldest account's phone and clearing the rest.
  phone         String?   @unique
  emailVerifiedAt DateTime?
  mfaSecret     String?   // set once enrollment starts, but mfaEnabled stays false until the first code is confirmed — see services/auth.service.js
  mfaEnabled    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  addresses     Address[]
  cart          Cart?
  wishlist      Wishlist[]
  orders        Order[]
  reviews       Review[]
  paymentIntents PaymentIntent[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@map("users")
}

// Backs phone-number OTP login. No relation to User — looked up by phone
// string at both request and verify time, since a row must be created (and
// a cooldown enforced) identically whether or not a matching account
// exists, to avoid leaking account existence through the cooldown itself
// (see auth.service.js's requestPhoneOtp). Only the SHA-256 hash of the
// code is stored, same reasoning as RefreshToken below.
model PhoneOtp {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("phone_otps")
}

// A revocable, DB-backed counterpart to the short-lived access token JWT —
// see backend/src/utils/jwt.js for why access tokens alone (7-day expiry,
// no revocation path) weren't enough. Only the SHA-256 hash of the raw
// token is stored (utils/refreshToken.js), same reasoning as passwordHash:
// a DB read alone should never be enough to impersonate a session. Rotated
// on every use (backend/src/services/auth.service.js's refresh flow) —
// revokedAt marks a token as no longer usable, whether from rotation,
// logout, or (future) an admin-initiated "log out everywhere."
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Separate auth realm from User, per project requirements — admins are not
// customers and don't share the customer login/session flow.
model AdminUser {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(STAFF)
  lastLoginAt  DateTime?
  mfaSecret    String?    // mandatory for admins — see requireAdmin's enforcement in middlewares/admin.middleware.js
  mfaEnabled   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?  // revoke admin access without losing the audit trail of who did what

  refreshTokens AdminRefreshToken[]

  @@index([email])
  @@map("admin_users")
}

// Admin's counterpart to RefreshToken above — kept as a fully separate
// model/table rather than a shared one, same realm-isolation reasoning as
// everything else admin-related in this schema (separate secrets, separate
// cookies): a bug or leak in one realm's refresh flow should never be able
// to touch the other's.
model AdminRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@map("admin_refresh_tokens")
}

// -----------------------------------------------------------------------------
// CATALOG
// -----------------------------------------------------------------------------

// Soft-deletes: hiding a category from the storefront shouldn't orphan
// products that still reference it, or break past orders that mention it.
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products    Product[]

  @@map("categories")
}

// Soft-deletes: same reasoning as Category — e.g. retiring a "Limited
// Edition" collection shouldn't orphan the products that shipped under it.
model Collection {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products    Product[]

  @@map("collections")
}

// Soft-deletes: a discontinued product must stay queryable forever because
// OrderItem, Review, and Wishlist rows reference it. Availability to
// customers is controlled by `isActive` + `stockQuantity`, not by deleting
// the row.
model Product {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  slug             String    @unique
  description      String
  price            Decimal   @db.Decimal(10, 2)
  compareAtPrice   Decimal?  @db.Decimal(10, 2) // original price, for showing a strikethrough discount
  sku              String?   @unique
  stockQuantity    Int       @default(0)
  isActive         Boolean   @default(true) // storefront visibility toggle, independent of soft delete
  isFeatured       Boolean   @default(false)
  isBestSeller     Boolean   @default(false)
  badge            String?   // e.g. "New", "Limited" — free-text tag shown on ProductCard
  brandLine        String?   // e.g. "XeleX Signature" / "XeleX Rare" / "XeleX Classic"
  inspiredBy       String?   // e.g. "Chanel No. 5" — shown as "(Inspired by X)" next to the name
  ratingAverage    Decimal   @default(0) @db.Decimal(2, 1)
  ratingCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  categoryId       String?   @db.Uuid
  category         Category? @relation(fields: [categoryId], references: [id])

  collectionId     String?   @db.Uuid
  collection       Collection? @relation(fields: [collectionId], references: [id])

  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  wishlistedBy     Wishlist[]

  @@index([categoryId])
  @@index([collectionId])
  @@index([slug])
  @@map("products")
}

// No soft delete — image rows are trivial and fully dependent on their
// product; if the product itself needs to disappear, cascading these away
// is fine (the product row stays via soft delete, only orphaned images from
// direct deletion would cascade, which shouldn't happen in normal operation).
model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// -----------------------------------------------------------------------------
// WISHLIST
// -----------------------------------------------------------------------------

// Wishlist IS the join table (no separate "WishlistItem" concept needed —
// saving/unsaving a product is a simple toggle, not a record worth retaining
// after removal). Hard delete is fine here.
model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId]) // a product can only be wishlisted once per user
  @@index([userId])
  @@map("wishlist")
}

// -----------------------------------------------------------------------------
// CART
// -----------------------------------------------------------------------------

// One active cart per user. Hard delete is fine — an abandoned cart has no
// historical value once its items are gone; Orders are the permanent record.
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId]) // adding an already-present product increments quantity instead of duplicating the row
  @@index([cartId])
  @@map("cart_items")
}

// -----------------------------------------------------------------------------
// ADDRESSES
// -----------------------------------------------------------------------------

// Soft-deletes: a past Order references the Address used at the time of
// purchase. If the customer deletes that address later, the order must still
// be able to show where it was shipped.
model Address {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String?   // "Home", "Work", etc.
  fullName      String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pincode       String
  country        String   @default("India")
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  orders        Order[]

  @@index([userId])
  @@map("addresses")
}

// -----------------------------------------------------------------------------
// ORDERS
// -----------------------------------------------------------------------------

// No soft delete on Order — orders are financial/legal records and are never
// deleted. Cancellation is modeled as a status transition (`CANCELLED`), not
// a delete, so the row and its history are always intact.
model Order {
  id             String        @id @default(uuid()) @db.Uuid
  orderNumber    String        @unique // human-readable, e.g. "XV-20260706-0001"
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id])
  addressId      String        @db.Uuid
  address        Address       @relation(fields: [addressId], references: [id])
  status         OrderStatus   @default(PENDING)
  subtotal       Decimal       @db.Decimal(10, 2)
  shippingFee    Decimal       @db.Decimal(10, 2) @default(0)
  // couponId is a traceability link only, nullable + SetNull so a coupon can
  // be hard-deleted later without breaking historical orders. couponCode/
  // discountAmount are the actual source of truth for what this order got —
  // a snapshot that survives the coupon being renamed, changed, or deleted,
  // same philosophy as OrderItem.productName/unitPrice below.
  couponId       String?       @db.Uuid
  coupon         Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode     String?
  discountAmount Decimal       @db.Decimal(10, 2) @default(0)
  total          Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          OrderItem[]
  payment        Payment?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

// Snapshots productName/unitPrice at the time of purchase — deliberately
// duplicated from Product rather than joined live, because a later price
// change or rename must NOT rewrite what a past invoice says the customer
// paid.
model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String   @db.Uuid
  product      Product  @relation(fields: [productId], references: [id])
  productName  String   // snapshot, not a live join
  unitPrice    Decimal  @db.Decimal(10, 2) // snapshot
  quantity     Int
  lineTotal    Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// No soft delete — a payment's history (pending → success/failed → refunded)
// is modeled with `status`, never erased. One payment per order.
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @unique @db.Uuid
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       // UPI reference ID; null for COD until collected
  amount        Decimal       @db.Decimal(10, 2)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@map("payments")
}

// Bridges the gap between "customer clicked pay" and "gateway confirmed" —
// Order/Payment can't exist yet at this point (Payment.orderId is required),
// so this is where the cart/shipping snapshot and gateway order id live
// until verification succeeds and a real Order gets built from it.
model PaymentIntent {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  gatewayOrderId String              @unique // Razorpay order_id
  amount         Decimal             @db.Decimal(10, 2)
  status         PaymentIntentStatus @default(CREATED)
  cartSnapshot   Json                // { items: [{productId, quantity}], shipping: {...} }
  transactionId  String?             // Razorpay payment_id, set once captured
  failureReason  String?
  orderId        String?             @unique @db.Uuid // set once the real Order is created, for traceability
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payment_intents")
}

// -----------------------------------------------------------------------------
// REVIEWS
// -----------------------------------------------------------------------------

// Soft-deletes: moderation should be able to hide a review (policy violation,
// spam) without permanently destroying the record, in case of disputes.
model Review {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int       // 1-5, enforced at the application layer
  title      String?
  comment    String?
  isApproved Boolean   @default(true) // moderation flag, independent of soft delete
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([productId, userId]) // one review per user per product
  @@index([productId])
  @@map("reviews")
}

// -----------------------------------------------------------------------------
// NEWSLETTER
// -----------------------------------------------------------------------------

// No `deletedAt` — unsubscribing is modeled as `unsubscribedAt`, which is
// more meaningful here than a generic soft-delete flag (re-subscribing just
// clears the timestamp rather than needing a whole new row).
model NewsletterSubscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

// -----------------------------------------------------------------------------
// HERO SLIDER
// -----------------------------------------------------------------------------

// No soft delete — purely presentational marketing content with nothing
// else referencing it (unlike Product/Category), so a real delete is safe.
// Same reasoning as ProductImage.
model HeroSlide {
  id          String   @id @default(uuid()) @db.Uuid
  imageUrl    String
  heading     String
  description String?
  buttonText  String?
  buttonLink  String?
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isEnabled])
  @@map("hero_slides")
}

// -----------------------------------------------------------------------------
// COUPONS
// -----------------------------------------------------------------------------

// No soft delete — "delete" here means a real delete, distinct from the
// `isActive` toggle (which is how admins deactivate a coupon without losing
// it). A hard delete is safe because Order.couponId is nullable with
// onDelete: SetNull — historical orders keep their couponCode/discountAmount
// snapshot regardless of what happens to this row afterward.
model Coupon {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique
  description       String?
  discountType      CouponDiscountType
  discountValue     Decimal            @db.Decimal(10, 2)
  minOrderAmount    Decimal?           @db.Decimal(10, 2)
  maxDiscountAmount Decimal?           @db.Decimal(10, 2) // caps a PERCENTAGE discount's rupee value
  expiresAt         DateTime?
  usageLimit        Int?               // null = unlimited
  usedCount         Int                @default(0)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  orders            Order[]

  @@index([code])
  @@map("coupons")
}
